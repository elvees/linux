/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

#include "mcom03r-elvmc03smarc-r3.0.0.dtsi"

/ {
	model = "ELV-MC03-SMARC r3.0.0, SALUTE-PM-ETT-SSMARC-r2.0.0";
	compatible = "elvees,elvmc03smarc-r3.0.0-salute-pm-ett-ssmarc-r2.0.0",
		     "elvees,elvmc03smarc-salute-pm-ett-ssmarc",
		     "elvees,salute-pm-ett-ssmarc-r2.0.0",
		     "elvees,salute-pm-ett-ssmarc",
		     "elvees,elvmc03smarc-r3.0.0",
		     "elvees,elvmc03smarc",
		     "elvees,mcom03r";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	salute-pm-ett-ssmarc-leds {
		compatible = "gpio-leds";

		status-led {
			gpios = <&xl9555 2 GPIO_ACTIVE_HIGH>;
			default-state = "on";
			linux,default-trigger = "heartbeat";
		};
	};
};

&sdhci1 {
	status = "okay";

	/* Disable 1.8V support
	 * Disable SDR50, SDR104 and DDR50 support
	 */
	sdhci-caps-mask = <0x7 0x4000000>;
	sdhci-caps = <0x0 0x0>;
};

&sdhci1_default {
	/* The default clock pad drive strength of 6 mA is insufficient
	 * for some ELV-SMARC-CBs resulting in unstable SDMMC performance
	 */
	clk {
		pins = "SDMMC1_CLK";
		drive-strength = <8>;
	};
};

/* Connects to USB HUB on Salute-PM-ETT */
&ser1 {
	status = "okay";
};

&emac0 {
	status = "okay";
};

&i2c_pm {
	status = "okay";
	clock-frequency = <100000>;

	/* ID EEPROM installed on SALUTE-PM-ETT-CBx r2.0.0 */
	eeprom@57 {
		compatible = "microchip,24c32", "atmel,24c32";
		reg = <0x57>;
	};
};

/* Set temperature values for high-temperature testing (#MCOM03SW-3338) */
&cpu_alert1 {
	temperature = <100000>;
};

&cpu_alert2 {
	temperature = <110000>;
};
