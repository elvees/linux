/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

#include "mcom03r-elvmc03smarc-r3.0.0.dtsi"

/ {
	model = "ELV-MC03-SMARC r3.0.0, SALUTE-PM-ETT-SSMARC-r2.0.0";
	compatible = "elvees,elvmc03smarc-r3.0.0-salute-pm-ett-ssmarc-r2.0.0",
		     "elvees,elvmc03smarc-salute-pm-ett-ssmarc",
		     "elvees,salute-pm-ett-ssmarc-r2.0.0",
		     "elvees,salute-pm-ett-ssmarc",
		     "elvees,elvmc03smarc-r3.0.0",
		     "elvees,elvmc03smarc",
		     "elvees,mcom03r";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	salute-pm-ett-ssmarc-leds {
		compatible = "gpio-leds";

		status-led {
			gpios = <&xl9555 2 GPIO_ACTIVE_HIGH>;
			default-state = "on";
			linux,default-trigger = "heartbeat";
		};
	};

	dummy_lvds_panel0: panel {
		compatible = "panel-lvds";

		width-mm = <527>;
		height-mm = <296>;

		data-mapping = "vesa-24";

		panel-timing {
			clock-frequency = <148500000>;
			hactive = <1920>;
			vactive = <1080>;
			hfront-porch = <88>;
			hsync-len = <44>;
			hback-porch = <148>;
			vfront-porch = <4>;
			vsync-len = <5>;
			vback-porch = <36>;
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				panel_input_0: endpoint {
					remote-endpoint = <&lt9211_lvds_out_0>;
				};
			};

			port@1 {
				reg = <1>;

				panel_input_1: endpoint {
					remote-endpoint = <&lt9211_lvds_out_1>;
				};
			};
		};
	};
};

&sdhci1 {
	status = "okay";

	/* Disable 1.8V support
	 * Disable SDR50, SDR104 and DDR50 support
	 */
	sdhci-caps-mask = <0x7 0x4000000>;
	sdhci-caps = <0x0 0x0>;
};

&sdhci1_default {
	/* The default clock pad drive strength of 6 mA is insufficient
	 * for some ELV-SMARC-CBs resulting in unstable SDMMC performance
	 */
	clk {
		pins = "SDMMC1_CLK";
		drive-strength = <8>;
	};
};

/* Connects to USB HUB on Salute-PM-ETT */
&ser1 {
	status = "okay";
};

&emac0 {
	status = "okay";
};

&i2c_pm {
	status = "okay";
	clock-frequency = <100000>;

	/* ID EEPROM installed on SALUTE-PM-ETT-CBx r2.0.0 */
	eeprom@57 {
		compatible = "microchip,24c32", "atmel,24c32";
		reg = <0x57>;
	};
};

/* Set temperature values for high-temperature testing (#MCOM03SW-3338) */
&cpu_alert1 {
	temperature = <100000>;
};

&cpu_alert2 {
	temperature = <110000>;
};

&dp {
	status = "okay";
};

&de_dpi {
	status = "okay";
};

&lt9211 {
	status = "okay";

	ports {
		// lvds-out
		port@2 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <2>;

			lt9211_lvds_out_0: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&panel_input_0>;
			};
		};

		port@3 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <3>;

			lt9211_lvds_out_1: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&panel_input_1>;
			};
		};
	};
};
