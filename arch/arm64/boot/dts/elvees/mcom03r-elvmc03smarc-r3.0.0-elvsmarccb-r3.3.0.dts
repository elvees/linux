/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

#include "mcom03r-elvmc03smarc-r3.0.0.dtsi"

/ {
	model = "ELV-MC03-SMARC r3.0.0, ELV-SMARC-CB r3.3.0";
	compatible = "elvees,elvmc03smarc-r3.0.0-elvsmarccb-r3.3.0",
		     "elvees,elvmc03smarc-elvsmarccb",
		     "elvees,elvsmarccb-r3.3.0",
		     "elvees,elvsmarccb",
		     "elvees,elvmc03smarc-r3.0.0",
		     "elvees,elvmc03smarc",
		     "elvees,mcom03r";

	aliases {
		i2c5 = &i2c_cam0;
		i2c6 = &i2c_cam1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	hdmi_connector: hdmi-connector {
		compatible = "hdmi-connector";
		label = "hdmi";

		type = "a";

		port {
			hdmi_connector_in: endpoint {
				remote-endpoint = <&lt9611_out>;
			};
		};
	};

	elvsmarccb_asound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "analog-audio";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-master = <&dailink1_master>;
		simple-audio-card,frame-master = <&dailink1_master>;
		simple-audio-card,continuous-clock;

		dailink1_master: simple-audio-card,cpu {
				sound-dai = <&mfbsp0_i2s>;
		};

		simple-audio-card,codec {
				sound-dai = <&es8327>;
		};
	};

	fancontrol: pwm-fan {
		compatible = "pwm-fan";
		pwms = <&pwm 1 40000 0>;
		#cooling-cells = <2>;
		cooling-levels = <0 102 180 230>;
		interrupt-parent = <&gpio0a>;
		interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
		pulses-per-revolution = <2>;
	};

	elvsmarccb-keys-with-irq {
		compatible = "gpio-keys";

		power {
			gpios = <&gpio0a 4 GPIO_ACTIVE_LOW>;
			label = "POWER";
			linux,code = <KEY_POWER>;
		};

		sleep {
			gpios = <&gpio0a 3 GPIO_ACTIVE_LOW>;
			label = "SLEEP";
			linux,code = <KEY_SLEEP>;
		};

		lid-switch {
			gpios = <&gpio0a 5 GPIO_ACTIVE_LOW>;
			label = "LID";
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;
			wakeup-source;
		};
	};

	gpio-poweroff {
		compatible = "gpio-poweroff";
		gpios = <&gpio0d 2 GPIO_ACTIVE_LOW>;
		timeout-ms = <1000>;
	};

	elvsmarccb-leds {
		compatible = "gpio-leds";

		gpio11-led {
			gpios = <&xl9555 6 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		gpio12-led {
			gpios = <&gpio1c 0 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};
};

&gpio0a {
	gpio-line-names = "GPIO6", "nSMB_ALERT", "SER0_CTS", "nSLEEP",
		"nPOWER_BTN", "nLID", "INT_LVDS_1V8", "SER0_RTS";
};

&gpio0d {
	gpio-line-names = "SER2_TX", "", "nCARRIER_SHDWN", "I2C_PM_CK",
		"I2C_PM_DAT", "GPIO1_CAM1_PWR#", "GPIO2_CAM0_RST#", "nUSER_LED1";
};

&gpio1b {
	gpio-line-names = "HDMI_I2S_SCLK", "HDMI_I2S_LRCLK", "HDMI_I2S_D",
		"GPIO0_CAM0_PWR#", "ESPI_RESET#", "", "SER1_TX", "SER1_RX";
};

&gpio1c {
	gpio-line-names = "GPIO12", "GPIO13", "nCHARGING", "nCHARGER_PRSNT",
		"nTEST", "CARRIER_STBY#", "FORCE_RECOV#", "";
};

&xl9555 {
	gpio-line-names = "GPIO4", "USB_HUB_RST#", "GPIO7", "GPIO8", "GPIO9",
		"GPIO10", "GPIO11", " PCIE_WAKE#", "nRST_ETH1", "nRST_ETH0",
		"nRST_HDMI", "", "INT_HDMI", "nINT_RTC", "nINT_ETH0", "nINT_ETH1";
};

&sdhci1 {
	status = "okay";

	/* Disable 1.8V support
	 * Disable SDR50, SDR104 and DDR50 support
	 */
	sdhci-caps-mask = <0x7 0x4000000>;
	sdhci-caps = <0x0 0x0>;
};

&sdhci1_default {
	/* The default clock pad drive strength of 6 mA is insufficient
	 * for some ELV-SMARC-CBs resulting in unstable SDMMC performance
	 */
	clk {
		pins = "SDMMC1_CLK";
		drive-strength = <8>;
	};
};

/* Connects to XP8(RS-232) or XP9(RS-485) chosen by SA5 switch */
&ser0 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&uart3_mux_data &uart3_mux_rtscts>;
};

/* Connects to debug USB Type-C port */
&ser1 {
	status = "okay";
};

/* Connects to XP12 RPi header */
&ser2 {
	status = "okay";
};

/* Connects to XP11 */
&ser3 {
	status = "okay";
};

&emac0 {
	status = "okay";
};

&emac1 {
	status = "okay";
};

// Increase pad current for higer speed - from 400-600 to 900+ Mbit/s.
&emac1_default {
	tx_data {
		groups = "emac1_tx";
		drive-strength = <6>;
	};

	txc {
		pins = "EMAC1_RGMII_TXC";
		drive-strength = <6>;
	};
};

&usb0 {
	status = "okay";
};

/* Connected to USB 3.0 hub */
&usb1 {
	status = "okay";
};

&i2c_pm {
	status = "okay";
	// not tested to work on 400k
	clock-frequency = <100000>;

	eeprom@57 {
		compatible = "microchip,24c32", "atmel,24c32";
		reg = <0x57>;
	};
};

&i2c_gp {
	status = "okay";
	// not tested to work on 400k
	clock-frequency = <100000>;

	tmp112_cb: temperature-sensor@48 {
		compatible = "ti,tmp112";
		reg = <0x48>;
	};

	es8327: codec@18 {
		compatible = "everest,es8326";
		reg = <0x18>;

		interrupt-parent = <&xl9555>;
		interrupts = <5 IRQ_TYPE_EDGE_RISING>;

		clocks = <&audio_mclk>;
		clock-names = "mclk";
		#sound-dai-cells = <0>;
		everest,mic1-src = [22];
		everest,mic2-src = [44];
		everest,jack-pol = [0e];
		everest,interrupt-src = [08];
		everest,interrupt-clk = [45];
	};
};

&spi0 {
	status = "okay";
	num-cs = <2>;
	cs-gpios = <&gpio0c 4 GPIO_ACTIVE_LOW>, <&gpio0c 5 GPIO_ACTIVE_LOW>;

	flash1: w25q128jw@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "winbond,w25q128fw", "jedec,spi-nor";
		spi-max-frequency = <20000000>;
		reg = <0x0>;
	};
};

/* Connected to XP3 socket through CAN transceiver */
&mfbsp0_can {
	status = "okay";
};

/* Connected to XP3 socket through CAN transceiver */
&mfbsp1_can {
	status = "okay";
};

&qlic0 {
	status = "okay";
};

&dp {
	status = "okay";
};

&de_dsi {
	status = "okay";
};

&lt9611uxc {
	status = "okay";

	ports {
		port@2 {
			reg = <2>;
			lt9611_out: endpoint {
				remote-endpoint = <&hdmi_connector_in>;
			};
		};
	};
};

&hdmi_sound {
	status = "okay";
};

&i2s0 {
	status = "okay";
};

/* SMARC S38-42 (I2S0*) pins connected to mfbsp0 */
&mfbsp0_i2s {
	status = "okay";
};

&audio_mclk {
	status = "okay";
};

&pwm {
		status = "okay";
		elvees,output-channel = <0 1 0 0>;
		elvees,state-on-disable = <0 1 0 0>;

		pinctrl-names = "default";
		pinctrl-0 = <&pwm_oenb1_mux>;
};

/*
 * Upon reaching the trip point the thermal subsystem driver enables the fans.
 *
 * Thermal zones can be enabled/disabled via sysfs by writing said state into
 * the corresponding /sys/class/thermal/thermal_zoneX/mode file.
 */
&trips {
	cpu_alert0: cpu-alert-0 {
		temperature = <50000>;
		hysteresis = <1000>;
		type = "active";
	};
};

&cooling_maps {
	map0 {
		trip = <&cpu_alert0>;
		cooling-device = <&fancontrol
				  THERMAL_NO_LIMIT
				  THERMAL_NO_LIMIT>;
	};
};

&qspi1 {
	status = "okay";

	qspi_flash: spi-nor@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor", "spi-flash";
		reg = <0x0>;
		/* Highest frequency for IC installed into socket */
		spi-max-frequency = <3000000>;
		m25p,fast-read;
	};
};

&qspi1_default {
	/* Max clock frequency is 1 MHz with default pad drive strength.
	 * This value increases max clock frequency to 3 MHz */
	clk {
		drive-strength = <10>;
	};
};

&sata {
	status = "okay";
};

&pcie1 {
	status = "okay";
};

&isp {
	status = "okay";
};

&csi0 {
	status = "okay";
};

&csi1 {
	status = "okay";
};
