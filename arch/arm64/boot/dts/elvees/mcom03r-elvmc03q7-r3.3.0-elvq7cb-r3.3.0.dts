/dts-v1/;

#include <dt-bindings/input/linux-event-codes.h>
#include "mcom03r-elvmc03q7-r3.3.0.dtsi"

/ {
	model = "ELV-MC03-Q7 r3.3.0, ELV-Q7-CB r3.3.0";
	compatible = "elvees,elvmc03q7-r3.3.0-elvq7cb-r3.3.0",
		     "elvees,elvmc03q7-elvq7cb",
		     "elvees,elvq7cb-r3.3.0",
		     "elvees,elvq7cb",
		     "elvees,elvmc03q7-r3.3.0",
		     "elvees,elvmc03q7",
		     "elvees,mcom03r";


	gpio-poweroff {
		compatible = "gpio-poweroff";
		gpios = <&gpio0d 7 GPIO_ACTIVE_LOW>; // Use SUS_S5 to poweroff
		timeout-ms = <1000>;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	elvq7cb-leds {
		compatible = "gpio-leds";

		vd20 {
			gpios = <&gpio0d 6 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		vd23 {
			gpios = <&gpio0c 7 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};

	elvq7cb-keys {
		compatible = "gpio-keys-polled";
		poll-interval = <100>;
		autorepeat;

		power {
			gpios = <&gpio0d 0 GPIO_ACTIVE_LOW>;
			label = "POWER";
			linux,code = <KEY_POWER>;
		};
	};

	elvq7cb-keys-with-irq {
		compatible = "gpio-keys";

		pinctrl-0 = <&wake_button_default>;
		pinctrl-names = "default";

		lid {
			gpios = <&gpio0a 1 GPIO_ACTIVE_LOW>;
			label = "LID";
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;
			wakeup-source;
		};

		sleep {
			gpios = <&gpio0a 3 GPIO_ACTIVE_LOW>;
			label = "SLEEP";
			linux,code = <KEY_SLEEP>;
			wakeup-source;
		};

		wake {
			gpios = <&gpio1a 6 GPIO_ACTIVE_LOW>;
			label = "WAKE";
			linux,code = <KEY_WAKEUP>;
			wakeup-source;
		};
	};

	hdmi_connector: hdmi-connector {
		compatible = "hdmi-connector";
		label = "hdmi";

		type = "a";

		port {
			hdmi_connector_in: endpoint {
				remote-endpoint = <&lt9611_out>;
			};
		};
	};


	/* "G1" oscillator */
	audio_mclk: audio_mclk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <12000000>;
	};

	/* TRS (3.5mm jack) connected to ES8327 codec.
	 * ES8327 connected to MCom-03 I2S0 as I2S slave.
	 */
	elvq7cb_i2s_asound: sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "analog-audio";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-master = <&dailink1_master>;
		simple-audio-card,frame-master = <&dailink1_master>;
		simple-audio-card,continuous-clock;

		dailink1_master: simple-audio-card,cpu {
			sound-dai = <&mfbsp0_i2s>;
		};

		simple-audio-card,codec {
		sound-dai = <&es8327>;
		};
	};

	fancontrol: pwm-fan {
		compatible = "pwm-fan";
		pwms = <&pwm 1 40000 0>;
		#cooling-cells = <2>;
		cooling-levels = <0 102 180 230>;
		interrupt-parent = <&gpio0a>;
		interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
	};
};

&lsperiph1_pinctrl {
	wake_button_default: wake-button-cfg {
		pins = "GPIOA_6";
		input-enable;
	};
};

&uart0 {
	status = "okay";
};

&sdhci1 {
	status = "okay";

	/* Disable 1.8V support
	 * Disable SDR50, SDR104 and DDR50 support
	 */
	sdhci-caps-mask = <0x7 0x4000000>;
	sdhci-caps = <0x0 0x0>;
};

/* Connected to USB 3.0 (USB0) */
&usb0 {
	status = "okay";
};

/* Connected to USB 2.0 (USB1, USB2-3) and USB 3.0 (USB4-5) */
&usb1 {
	status = "okay";
};

&i2c0 {
	status = "okay";
	clock-frequency = <100000>;

	tmp112_1: temperature-sensor@48 {
		compatible = "ti,tmp112";
		reg = <0x48>;
	};
};

&i2c1 {
	status = "okay";

	es8327: codec@18 {
		compatible = "everest,es8326";
		reg = <0x18>;

		interrupt-parent = <&gpio0a>;
		interrupts = <4 IRQ_TYPE_EDGE_RISING>;

		clocks = <&audio_mclk>;
		clock-names = "mclk";
		#sound-dai-cells = <0>;
		everest,mic1-src = [22];
		everest,mic2-src = [44];
		everest,jack-pol = [0e];
		everest,interrupt-src = [08];
		everest,interrupt-clk = [45];
	};

	eeprom@57 {
		compatible = "microchip,24c32", "atmel,24c32";
		reg = <0x57>;
	};
};

/* Connected to PCIe slot XS3 */
&pcie1 {
	status = "okay";
};

&qspi1 {
	status = "okay";
	num-cs = <2>;

	flash1: w25q128@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor", "spi-flash";
		reg = <0x0>;
		/* This is the highest frequency at which all commands are
		 * supported by the flash device.
		 */
		spi-max-frequency = <50000000>;
		m25p,fast-read;
	};

	flash2: w25q128@1 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor", "spi-flash";
		reg = <0x1>;
		/* This is the highest frequency at which all commands are
		 * supported by the flash device.
		 */
		spi-max-frequency = <50000000>;
		m25p,fast-read;
	};
};

/* Connected to SATA plug */
&sata {
	status = "okay";
};

/* Connected to RJ-45 (XS1) */
&emac0 {
	status = "okay";
};

&dp {
	status = "okay";
};

&de_dsi {
	status = "okay";
};

&lt9611uxc {
	status = "okay";

	ports {
		port@2 {
			reg = <2>;
			lt9611_out: endpoint {
				remote-endpoint = <&hdmi_connector_in>;
			};
		};
	};
};

&i2s0 {
	status = "okay";
};

&hdmi_sound {
	status = "okay";
};

&mfbsp0_i2s {
	status = "okay";
};

&qlic0 {
	status = "okay";
};

&pwm {
	status = "okay";
	elvees,output-channel = <0 0 0 0>;
	elvees,state-on-disable = <0 1 0 0>;

	pinctrl-names = "default";
	pinctrl-0 = <&pwm_oena1_mux>;
};

/*
 * Upon reaching the trip point the thermal subsystem driver enables the fans.
 *
 * Thermal zones can be enabled/disabled via sysfs by writing said state into
 * the corresponding /sys/class/thermal/thermal_zoneX/mode file.
 */
&trips {
	cpu_alert0: cpu-alert-0 {
		temperature = <50000>;
		hysteresis = <1000>;
		type = "active";
	};
};

&cooling_maps {
	map0 {
		trip = <&cpu_alert0>;
		cooling-device = <&fancontrol
				  THERMAL_NO_LIMIT
				  THERMAL_NO_LIMIT>;
	};
};

/* Connected to XP14 socket through CAN transceiver */
&mfbsp1_can {
	status = "okay";
};

/* Connects to XP15(RS-232) or XP16(RS-485) chosen by SA7 switch */
ser0: &uart3 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&uart3_mux_data &uart3_mux_rtscts>;
};

/*
 * All QSPI interfaces connected to the Q7 module operates at the same clock
 * frequency.
 * However, the QSPI on the Q7-CB did not work at 50 MHz for no apparent
 * reason - likely due to the effect of trace length. To resolve this, we
 * increased the pad current to 6mA.
 */
&qspi1_default{
	data_and_ss {
		drive-strength = <6>;
	};

	clk {
		drive-strength = <6>;
	};
};
