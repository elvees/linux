config DRM_MCOM03_DISPLAY_ENCODER
	tristate "MCom-03/MCom-03R display encoder"
	depends on DRM && OF && (ARCH_MCOM03 || ARCH_MCOM03R)
	depends on COMMON_CLK
	select DRM_DW_MIPI_DSI
	help
	  Choose this option if you want to compile the display encoder for
	  parallel RGB and MIPI DSI support for MCom-03/MCom-03R SoCs
